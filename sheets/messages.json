{
  "sheet": "messages",
  "description": "The bridge protocol between BeamLS.asi (GTA) and the beamls Lua extension (BeamNG): one JSON object per UDP datagram on 127.0.0.1, {\"t\":\"<id>\", ...fields}. Each row generates a C++ struct with encode/decode (gta/src/gen/protocol.hpp) and a Lua encode/decode pair (beamng/.../gen/protocol.lua). Field types: f32, i32, u32, bool, str, f32[], rec[] (array of records, each encoded as an array in field order).",
  "key": "id",
  "columns": {
    "id": "Message type, the value of t",
    "dir": "g2b (GTA to BeamNG), b2g (BeamNG to GTA) or both",
    "rate": "When it is sent",
    "fields": "List of [name, type, meaning]; rec[] fields carry a 4th element: the record's fields in the same form",
    "purpose": "What it is for",
    "sender": "System that sends it",
    "receiver": "System that handles it"
  },
  "optional": [],
  "refs": {"sender": "systems", "receiver": "systems"},
  "proto": 1,
  "rows": [
    {"id": "hello", "dir": "g2b", "rate": "1 Hz until hello_ack, then never",
     "fields": [["proto", "i32", "protocol version, must equal the sheet's proto"], ["gta_build", "str", "GTA5.exe build, e.g. 3889"], ["session", "u32", "random id for this GTA run"]],
     "purpose": "GTA announces itself; BeamNG starts the session", "sender": "gta_bridge", "receiver": "bng_listener"},
    {"id": "hello_ack", "dir": "b2g", "rate": "once per hello",
     "fields": [["proto", "i32", "protocol version"], ["bng_version", "str", "BeamNG version string"], ["session", "u32", "echo of hello.session"], ["ready", "bool", "true once the empty level is loaded and the scene is prepared"]],
     "purpose": "BeamNG answers; ready=false means still loading", "sender": "bng_listener", "receiver": "gta_bridge"},
    {"id": "bye", "dir": "both", "rate": "on shutdown",
     "fields": [["reason", "str", "why: quit, online, error"]],
     "purpose": "Either side is going away", "sender": "gta_bridge", "receiver": "bng_session"},
    {"id": "mode", "dir": "g2b", "rate": "on change and 1 Hz",
     "fields": [["state", "str", "off, onfoot, drive, menu_vehicle, menu_tuning, paused"], ["reason", "str", "short reason for logs"]],
     "purpose": "What the player is doing in GTA; BeamNG pauses, parks, opens menus accordingly", "sender": "gta_main", "receiver": "bng_main"},
    {"id": "cam", "dir": "g2b", "rate": "every GTA frame",
     "fields": [["seq", "u32", "increasing frame counter"], ["px", "f32", "camera x (m, GTA world)"], ["py", "f32", "camera y"], ["pz", "f32", "camera z"], ["qx", "f32", "rotation quaternion x (forward +Y, up +Z)"], ["qy", "f32", "quaternion y"], ["qz", "f32", "quaternion z"], ["qw", "f32", "quaternion w"], ["fov", "f32", "vertical field of view, degrees"], ["near", "f32", "near clip, m"], ["w", "i32", "GTA back buffer width, px"], ["h", "i32", "GTA back buffer height, px"]],
     "purpose": "BeamNG renders its car from exactly GTA's camera", "sender": "gta_camera_sync", "receiver": "bng_camera"},
    {"id": "input", "dir": "g2b", "rate": "every GTA frame while driving",
     "fields": [["seq", "u32", "frame counter"], ["throttle", "f32", "0..1"], ["brake", "f32", "0..1"], ["steer", "f32", "-1 (left) .. 1 (right)"], ["handbrake", "f32", "0..1"], ["horn", "bool", "horn held"], ["lights", "bool", "toggle headlights this frame"]],
     "purpose": "The player's controls for the BeamNG car", "sender": "gta_input", "receiver": "bng_input"},
    {"id": "ground", "dir": "g2b", "rate": "5 Hz while the car is near the player",
     "fields": [["seq", "u32", "probe round"], ["ox", "f32", "grid origin x (south-west corner, m)"], ["oy", "f32", "grid origin y"], ["step", "f32", "cell size, m"], ["n", "i32", "grid is n x n points"], ["z", "f32[]", "n*n ground heights, row-major from origin along +x then +y; -10000 = no ground found"]],
     "purpose": "GTA's ground under and around the car, for BeamNG's collision slabs", "sender": "gta_ground_probe", "receiver": "bng_ground"},
    {"id": "walls", "dir": "g2b", "rate": "10 Hz while driving",
     "fields": [["seq", "u32", "probe round"], ["hits", "rec[]", "wall and prop hits", [["x", "f32", "hit x"], ["y", "f32", "hit y"], ["z", "f32", "hit z"], ["nx", "f32", "surface normal x"], ["ny", "f32", "normal y"], ["nz", "f32", "normal z"], ["kind", "i32", "obstacle class id (sheet obstacles: 1 wall, 2 prop)"], ["size", "f32", "prop radius in m, 0 for walls"]]]],
     "purpose": "Walls, poles and props near the car", "sender": "gta_wall_probe", "receiver": "bng_walls"},
    {"id": "traffic", "dir": "g2b", "rate": "20 Hz while driving",
     "fields": [["seq", "u32", "round"], ["cars", "rec[]", "GTA vehicles near the BeamNG car", [["id", "i32", "GTA entity handle"], ["cls", "i32", "GTA vehicle class (18 = emergency)"], ["x", "f32", "centre x"], ["y", "f32", "centre y"], ["z", "f32", "centre z"], ["qx", "f32", "quaternion x"], ["qy", "f32", "quaternion y"], ["qz", "f32", "quaternion z"], ["qw", "f32", "quaternion w"], ["vx", "f32", "velocity x m/s"], ["vy", "f32", "velocity y"], ["vz", "f32", "velocity z"], ["l", "f32", "length m"], ["w", "f32", "width m"], ["h", "f32", "height m"]]]],
     "purpose": "Traffic and police for BeamNG's solid proxies", "sender": "gta_traffic", "receiver": "bng_traffic"},
    {"id": "spawn_at", "dir": "g2b", "rate": "when the car must be placed",
     "fields": [["x", "f32", "x"], ["y", "f32", "y"], ["z", "f32", "ground z"], ["heading", "f32", "GTA heading, degrees (0 = north, counter-clockwise)"]],
     "purpose": "Place (or move) the BeamNG car at a GTA spot, e.g. next to the player after choosing a car", "sender": "gta_proxy_car", "receiver": "bng_player_car"},
    {"id": "repair", "dir": "g2b", "rate": "on demand",
     "fields": [["garage", "str", "garage id (sheet garages)"]],
     "purpose": "Repair the BeamNG car", "sender": "gta_repair_zones", "receiver": "bng_repair"},
    {"id": "time", "dir": "g2b", "rate": "every 5 s",
     "fields": [["hour", "i32", "0..23"], ["minute", "i32", "0..59"]],
     "purpose": "GTA's clock for BeamNG's sun", "sender": "gta_time_sync", "receiver": "bng_time"},
    {"id": "car", "dir": "b2g", "rate": "every BeamNG frame",
     "fields": [["seq", "u32", "BeamNG frame counter"], ["cam_seq", "u32", "cam.seq BeamNG's camera used for the frame being rendered"], ["x", "f32", "car reference x (GTA world)"], ["y", "f32", "y"], ["z", "f32", "z"], ["qx", "f32", "rotation quaternion x, GTA convention (forward +Y)"], ["qy", "f32", "y"], ["qz", "f32", "z"], ["qw", "f32", "w"], ["vx", "f32", "velocity x m/s"], ["vy", "f32", "velocity y"], ["vz", "f32", "velocity z"], ["wx", "f32", "angular velocity x rad/s"], ["wy", "f32", "angular velocity y"], ["wz", "f32", "angular velocity z"], ["bx", "f32", "box centre x"], ["by", "f32", "box centre y"], ["bz", "f32", "box centre z"], ["hx", "f32", "box half width (car right)"], ["hy", "f32", "box half length (car forward)"], ["hz", "f32", "box half height"], ["speed", "f32", "m/s"], ["damage", "f32", "BeamNG beamstate damage"]],
     "purpose": "Where the BeamNG car is, for GTA's proxy car and the compositor", "sender": "bng_player_car", "receiver": "gta_proxy_car"},
    {"id": "vehicle_info", "dir": "b2g", "rate": "on spawn, replace or config change",
     "fields": [["model", "str", "BeamNG model folder, e.g. etk800"], ["config", "str", "config file name"], ["name", "str", "display name"], ["length", "f32", "m"], ["width", "f32", "m"], ["height", "f32", "m"], ["mass", "f32", "kg"]],
     "purpose": "What car the player has; GTA picks a proxy model of the same size", "sender": "bng_player_car", "receiver": "gta_proxy_car"},
    {"id": "menu_closed", "dir": "b2g", "rate": "when the player leaves BeamNG's menu",
     "fields": [["changed", "bool", "the car or its tuning changed"]],
     "purpose": "Return focus and control to GTA", "sender": "bng_menu", "receiver": "gta_hotkeys"},
    {"id": "status", "dir": "b2g", "rate": "on change and 1 Hz",
     "fields": [["state", "str", "loading, ready, menu, error"], ["msg", "str", "human readable detail"]],
     "purpose": "BeamNG's side of the session, for GTA's HUD and logs", "sender": "bng_main", "receiver": "gta_main"}
  ]
}
